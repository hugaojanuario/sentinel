# Port the backend will listen on
PORT=9090

# Port exposed for the frontend
FRONTEND_PORT=80

# Docker socket path
# Linux / macOS: /var/run/docker.sock  (default, no need to change)
# Windows (Docker Desktop + WSL2): //var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=admin
DB_PASSWORD=123456
DB_SSLMODE=disable
